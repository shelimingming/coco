# 基础环境
COCO_ENVIRONMENT=development
COCO_LOG_LEVEL=INFO
COCO_DATABASE_URL=postgresql+asyncpg://coco:coco_dev_password@127.0.0.1:5432/coco

# JWT / 摘要密钥（本地开发默认值，上线前必须更换）
COCO_AUTH_SIGNING_KEY=local-development-only-change-before-sharing-0123456789
COCO_AUTH_HASH_PEPPER=local-development-pepper-change-me-0123456789abcdef
COCO_AUTH_ISSUER=coco-backend
COCO_AUTH_AUDIENCE=coco-ios
COCO_ACCESS_TOKEN_TTL_SECONDS=3600
COCO_REFRESH_TOKEN_TTL_DAYS=30

# 手机验证码
COCO_SMS_PROVIDER=dev
COCO_DEV_SMS_CODE=246810
COCO_OTP_TTL_SECONDS=300
COCO_OTP_MAX_ATTEMPTS=5
COCO_OTP_REQUEST_LIMIT_PER_HOUR=5

# CORS（逗号分隔，开发可用 *）
COCO_CORS_ALLOWED_ORIGINS=*

# 邀请短链对外域名（生产改为 https://coco.xyfit.top）
COCO_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Flutter Web 静态目录；Docker 用 /app/web；本地 dev_web.sh 会自动设为 frontend/build/web
# COCO_WEB_STATIC_DIR=/app/web

# 阿里云百炼（密钥只写本机 .env，勿提交仓库）
# 也可用 DASHSCOPE_API_KEY 作为别名
COCO_ALIYUN_API_KEY=
COCO_ALIYUN_REGION=cn-beijing
# 实时语音陪伴模型 / 音色
COCO_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
COCO_REALTIME_VOICE=longanqian
# 文本模型：子女报平安转译、通话结束后生成会话标题
COCO_TEXT_MODEL=qwen-plus
# 识图模型：须支持图片输入（帮我看看）；qwen-plus 不可用
COCO_VISION_MODEL=qwen3.7-plus
# 文生图：默认万相 2.7；可改为 wan2.7-image-pro / wan2.6-t2i / qwen-image-plus 等
COCO_IMAGE_MODEL=wan2.7-image
# 识图追问外壳 ASR / TTS（非实时语音）
COCO_ASR_MODEL=qwen-audio-3.0-asr-flash
COCO_TTS_MODEL=qwen3-tts-flash
COCO_TTS_VOICE=Cherry

# Mem0 长期记忆（自托管 OSS + 同库 pgvector；需超级用户先执行：
#   CREATE EXTENSION IF NOT EXISTS vector;
# 扩展装在 public；连接 search_path 为 coco,public，表仍落在 coco）
# COCO_MEM0_ENABLED=true
# COCO_MEM0_EMBEDDING_MODEL=text-embedding-v4
# COCO_MEM0_EMBEDDING_DIMS=1024
# COCO_MEM0_COLLECTION_NAME=coco_memories
# 变更历史 SQLite；Docker 内建议挂卷，例如 /data/mem0/history.db
# COCO_MEM0_HISTORY_DB_PATH=.mem0/history.db
# COCO_MEM0_INJECT_LIMIT=20
# COCO_MEM0_SEARCH_LIMIT=5

# 运营调试：把每次大模型调用写入 llm_traces（后台「模型调试」）；关则完全不写
# COCO_LLM_TRACE_ENABLED=true

# 百度 BOS 对象存储（密钥只写本机 .env，勿提交仓库）
# COCO_BOS_ACCESS_KEY_ID=
# COCO_BOS_SECRET_ACCESS_KEY=
# COCO_BOS_ENDPOINT=https://bj.bcebos.com
# COCO_BOS_BUCKET=coco-oss
# COCO_BOS_URL_TTL_SECONDS=3600
